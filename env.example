# Optional production PostgreSQL connection.
# Leave empty for local SQLite development.
DATABASE_URL=

# Secret used by local AI workers when posting heartbeat data.
WORKER_API_KEY=change-this-to-a-long-random-value

# Optional browser-accessible live stream URLs.
# Configure only if your cameras expose HTTP/MJPEG/HLS-compatible URLs.
CAMERA_URL_1=
CAMERA_URL_2=
CAMERA_URL_3=
# ... up to CAMERA_URL_25
